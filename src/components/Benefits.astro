      <!-- Right Content - All App Screenshots Together -->
      <div class="relative min-h-[600px] lg:min-h-[700px]">
        <!-- Background gradient blur -->
        <div
          class="absolute inset-0 bg-gradient-to-br from-[#F7C720]/20 to-[#E5B91A]/20 rounded-3xl blur-3xl"
        >
        </div>

        <!-- Main container with all 3 screenshots -->
        <div class="relative h-full flex items-center justify-center">
          <!-- Recipe screenshot (left, slightly behind) -->
          <div class="absolute top-8 left-0 lg:left-4 z-10">
            <img
              src="recipe-chickpea-screenshot.png"
              alt="Lemon App — Recipe with full nutrition breakdown"
              class="w-52 lg:w-60 h-auto rounded-3xl shadow-2xl border-8 border-white transform -rotate-2 hover:rotate-0 transition-transform duration-300"
            />
          </div>

          <!-- Entry screenshot (center, main focus) -->
          <div class="relative z-20 mx-auto">
            <img
              src="lemon-app-entry-screenshot.png"
              alt="Lemon App — Log a meal with natural language"
              class="w-64 lg:w-72 h-auto rounded-3xl shadow-2xl border-8 border-white"
            />
          </div>

          <!-- Result screenshot (right, overlapping) -->
          <div class="absolute top-16 right-0 lg:right-4 z-30">
            <img
              src="lemon-app-result-screenshot.png"
              alt="Lemon App — Instant macro results"
              class="w-52 lg:w-60 h-auto rounded-3xl shadow-2xl border-8 border-white transform rotate-2 hover:rotate-0 transition-transform duration-300"
            />
          </div>

          <!-- Floating elements -->
          <div
            class="absolute top-4 -left-4 w-12 h-12 bg-[#F7C720] rounded-full opacity-60 animate-pulse z-40"
          >
          </div>
          <div
            class="absolute bottom-1/3 -right-2 w-8 h-8 bg-[#E5B91A] rounded-full opacity-40 z-40"
          >
          </div>
        </div>

        <!-- Caption -->
        <div class="text-center mt-12">
          <p class="text-gray-600 font-medium text-lg">
            Cook what you love. Know what you eat.
          </p>
          <p class="text-sm text-gray-500 mt-2">
            Available on iOS. Free to start.
          </p>
        </div>
